            color: var(--dark);
            border: none;
            border-radius: 5px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            margin-top: 10px;
            transition: background 0.3s;
        }
        .btn-claim:hover {
            background-color: #d4ac0d;
        }
        .error-message {
            color: red;
            margin-top: 10px;
            display: none;
            font-weight: bold;
        }
        .success-message {
            color: var(--safe-green);
            margin-top: 10px;
            display: none;
            font-weight: bold;
        }
        /* Jobs Section */
        .jobs {
