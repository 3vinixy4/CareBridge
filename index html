    <script>
        function claimCoins() {
            var code = document.getElementById("transactionCode").value.trim();
            var errorMsg = document.getElementById("errorMsg");
            var successMsg = document.getElementById("successMsg");

            if (code === "") {
                errorMsg.style.display = "block";
                successMsg.style.display = "none";
            } else {
                errorMsg.style.display = "none";
                successMsg.style.display = "block";
                
                // Create the WhatsApp message
                var message = "Hello, I have purchased CareBridge Premium Coins. My M-Pesa Transaction Code is: " + code + ". Please activate my premium package.";
                var whatsappUrl = "https://wa.me/254706016727?text=" + encodeURIComponent(message);
                
                // Redirect to WhatsApp after 1.5 seconds so user sees the success message
                setTimeout(function() {
                    window.open(whatsappUrl, '_blank');
                }, 1500);
            }
        }
    </script>
