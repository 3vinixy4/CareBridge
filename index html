            margin-top: 0;
        }
        .mpesa-instructions {
            background-color: var(--safe-green);
            color: white;
            padding: 15px;
            border-radius: 8px;
            margin: 20px 0;
            text-align: left;
        }
        .mpesa-instructions ol {
            margin: 0;
            padding-left: 20px;
        }
        .input-group {
